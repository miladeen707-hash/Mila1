def flip_num(n):
    if n//10==0:
        return n
    last=n%10 
    rest=flip_num(n//10)
    return last*pow(10,len(str(rest)))+rest
print("reverse a number flip number peels last digit with % 10 an then recurses on //10")
print("flip number(500)",flip_num(500))
print("flip number(456)",flip_num(456))
