def sum(a,b):
  return a+b
def sub(a,b):
  return a-b
def mul(a,b):
  return a*b
def div(a,b):
  return a/b
choice=input("Enter your choice Add,Minus,Times,Divide")
num1=int(input("Enter first number"))
num2=int(input("Enter second number"))
if choice=='Add':
  print("sum of two numbers is",sum(num1,num2))
if choice=='Minus':
  print("sub of two numbers is",sub(num1,num2))
if choice=='Times':
  print("mul of two numbers is",mul(num1,num2))
if choice=='Divide':
  print("div of two numbers is",div(num1,num2))
