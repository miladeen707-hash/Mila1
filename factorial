#factorial
def factorial(n):
    if n==0:
        return 1
    return n * factorial(n-1)
input("recursion - a funtion calls itself untill a base case stops it.Press Enter")
print("factorial(3)=3*2*1",factorial(3))
print("factorial(4)=4*3*2*1",factorial(4))
n=int(input("Enter a number (try 5 or 6)"))
guess=input("What is factorial of("+str(n)+")")
print("factorial of",factorial(n),"your guess",guess)
