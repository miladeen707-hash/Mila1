n=int(input("Enter a number(try 8 or 14)"))
temp=n
pos=0
while temp>0:
    print("binary ",bin(temp)[2:])
    if temp & 1:
        break
    pos += 1
    temp>>=1
print("First set bit of n is",n,"Is at position",pos)
