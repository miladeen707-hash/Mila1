#import tkinter and create the window
from tkinter import *
window =Tk()
window.title("My Profile Card")
window.geometry("400x300")
title=Label(window,text="My Profile Card",fg="white",bg="purple",width=40)
title.grid(row=0,column=0, columnspan=2,padx=10,pady=10)
name_label=Label(window,text="Name",fg="white",bg="purple")
name_label.grid(row=1,column=0,padx=10,pady=10)
name_entry=Entry(window,fg="white",bg="purple",width=25)
name_entry.grid(row=1,column=1,padx=10,pady=10)
hobby_label=Label(window,text="Name",fg="white",bg="purple")
hobby_label.grid(row=2,column=0,padx=10,pady=10)
hobby_entry=Entry(window,fg="white",bg="purple",width=25)
hobby_entry.grid(row=2,column=1,padx=10,pady=10)
about_frame=Frame(window,relief=RAISED,borderwidth=2)
about_frame.grid(row=3,column=0,columnspan=2,padx=10,pady=10)
about_label=Label(about_frame,text="About Me",fg="white",bg="purple")
about_label.pack()
about_text=Text(about_frame,fg="white",bg="purple",width=30,height=5)
about_text.pack()
submit=Button(window,text="Show My Card",fg="white",bg="purple",width=20)
submit.grid(row=4,column=0,columnspan=2,padx=10,pady=10)
window.mainloop()
