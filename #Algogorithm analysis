#Part 2 formula ways always 1 step
#Algorithm :Use the shortcut formula to get the answer instantly
#Paeudocode :total=n*(n+1)/2
#time cost : 1 step-always -stays the same nomatter how big the n is
#Space cost:1 variable (total)
total=n*(n+1)/2
print("Fomula way:total=",total,"steps=1")
#part3 loop way
#Algorithm :add 1 each rounds pints one bye one using a loop
#Paeudocode :For rounds from 1 to n :total =total+round
#time cost : n steps- grows with the number of rounds
#Space cost:2 variables(total,rounds_num)
total=0
steps=0
for rounds_num in range(1,n+1):
    total=total=rounds_num
    steps=steps+1
    print("Loop way:total=",total,"steps=",steps)
    #part 4 
    #Algorithm :add 1 at a time for every single point in every round
#Paeudocode :For rounds from 1 to n :for points from 1 to round ,total+=1
#time cost : n * n steps- explodes as n grows
#Space cost:3 variables(total,rounds_num,point)
total=0
steps=0
for rounds_num in range(1,n+1):
    for points in range(1,rounds_num+1):
     total+=1
     steps+=1
print("NestedLoop way:total=",total,"steps=",steps)
