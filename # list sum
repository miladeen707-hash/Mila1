# list sum
def list_sum(lst):
    if lst==[]:
        return 0
    return lst[0]+list_sum(lst[1:])
print("Rercursive sum--- add head to sum of the tail until list becomes emty")
print("list_sum[1,2,3]=",list_sum([1,2,3,]))
print("list_sum[10,20,30]=",list_sum([10,20,30,]))
