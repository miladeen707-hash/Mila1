names=["Mila","Roya","Lamar","Gaia","Georgia"]
scores=[90,89,80,82,80]
n=len(scores)
print("==Score Tracker(n=",n,"players)==")
for i in range(n):
    print(i+1,".",names[i],":",scores[i],sep="")
print()
