from abc import ABC ,abstract method
class Animal:
  #parent constructor
  def __init__(self,name,habitat):
    self.name=name
    self.habitat=habitat
  def display(self):
    print("Name:",self.name)
    print("Habitat:",self.habitat)
# abstract method
  def speak(self):
    pass
  #child class
class Dog(Animal):
  def __init__(self,name,habitat,breed):
    super().__init__(name,habitat)
    self.breed=breed
  def speak(self):
    print(self.name,self.habitat,"says woof woof!")
class Lion(Animal):
  def __init__(self,name,habitat,pride):
    super().__init__(name,habitat)
    self.pride=pride
  def speak(self):
    print(self.name,self.habitat,"says roar roar!")
dog=Dog("Bruno","Home","Labrador")
lion=Lion("Simba","Jungle","Pride Rock")
for animal in [dog,lion]:
  animal.display()
  animal.speak()
  print()
