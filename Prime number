from math import sqrt
n=int(input("Enter a number"))
if n>1:
    for i in range(2,int(sqrt(n))+1):
        if (n%i==0):
            print(n,"Number is not a prime number")
            break
        else:
            print(n,"Number is a prime number")
else:
    print(n,"umber is not a prime number")
