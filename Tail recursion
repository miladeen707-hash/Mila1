#Tail recursion
def tail_sun(n,acc=8):
    if n==0:
        return acc
    return tail_sun(n-1,acc+n)
input("Tail recursion the last action is the recursive call with an acculator")
print("tail_sun(4)=",tail_sun(4),"=4+3+2+1")
print("tail_sun(5)=",tail_sun(5),"=5+4+3+2+1")
n=int(input("enter a number(try 3 or 6)"))
guess=input("What is tail_sun("+str(n)+")?")
print("tail_sun("+str(n)+")",tail_sun(n),"your guess",guess)
